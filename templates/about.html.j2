<style>
  :root {
    --bg: #0a0e14; --panel: #131a23; --ink: #e8eef5; --muted: #8a99ab;
    --accent: #ff3b3b; --accent-2: #ffb84d; --line: #28323e;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg); color: var(--ink);
    font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
  }
  a { color: #7cc1ff; }
  .wrap { max-width: 760px; margin: 0 auto; padding: 40px 20px 80px; }
  header { margin-bottom: 30px; }
  h1 { margin: 0 0 6px; font-size: 28px; letter-spacing: -0.02em; }
  h1 .dot {
    display: inline-block; width: 10px; height: 10px; border-radius: 50%;
    background: var(--accent); margin-right: 10px;
    box-shadow: 0 0 0 4px rgba(255,59,59,.18);
  }
  h2 { margin-top: 36px; font-size: 18px; letter-spacing: 0.02em;
       text-transform: uppercase; color: var(--accent-2); }
