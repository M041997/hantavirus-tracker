<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Outbreak Monitor — live tracker of active disease outbreaks</title>
<meta name="description" content="Live, hourly-updated tracker of active disease outbreaks — the US cyclosporiasis surge, hantavirus clusters, Ebola, mpox and H5N1 — with a global map and news from CDC, ECDC, WHO, ProMED-mail and Google News.">
<link rel="canonical" href="{{ site_url }}/">
<meta property="og:title" content="Outbreak Monitor — live tracker of active disease outbreaks">
<meta property="og:description" content="Live, hourly-updated tracker of active disease outbreaks with a global map and news from CDC, ECDC, WHO and ProMED-mail.">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site_url }}/">
<meta property="og:image" content="{{ site_url }}/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Outbreak Monitor">
<meta name="twitter:description" content="Live tracker of active disease outbreaks with a global map and news.">
<meta name="twitter:image" content="{{ site_url }}/og.png">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><text y=%2250%22 font-size=%2256%22>&#129440;</text></svg>">
{% if analytics_code %}
<script data-goatcounter="https://{{ analytics_code }}.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
{% endif %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>
<style>
  :root {
    --bg: #0a0e14;
    --panel: #131a23;
    --panel-2: #1d2632;
    --ink: #e8eef5;
    --muted: #8a99ab;
    --accent: #ff3b3b;
    --accent-2: #ffb84d;
    --accent-3: #6db8ff;
    --good: #58c897;
    --line: #28323e;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: #7cc1ff; text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* ---------- HERO MAP ---------- */
  .hero {
    position: relative;
    height: 70vh;
    min-height: 520px;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  #map {
    height: 100%; width: 100%;
    background: #0a1828;
  }
  .leaflet-container { background: #0a1828; outline: none; }
  .leaflet-control-attribution {
    background: rgba(10,14,20,.7) !important;
    color: #6b7785 !important;
    font-size: 10px !important;
  }
  .leaflet-control-attribution a { color: #8a99ab !important; }
  .leaflet-control-zoom a {
    background: rgba(20,28,38,.85) !important;
    color: #e8eef5 !important;
    border: 1px solid var(--line) !important;
  }

  /* HUD overlays */
  .hud {
    position: absolute; pointer-events: none; z-index: 500;
  }
  .hud-tl { top: 14px; left: 14px; }
  .hud-tr { top: 14px; right: 14px; }
  .hud-bl { bottom: 14px; left: 14px; }
  .hud-br { bottom: 14px; right: 14px; }
  .hud-bc {
    bottom: 14px; left: 50%; transform: translateX(-50%);
    color: var(--muted); font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(10,14,20,.6); padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--line);
  }

  .title-card {
    background: linear-gradient(135deg, rgba(20,28,38,.92), rgba(15,20,28,.85));
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 16px;
    pointer-events: auto;
  }
  .title-card h1 {
    margin: 0; font-size: 18px; letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .title-card h1 .dot {
    display: inline-block; width: 9px; height: 9px; border-radius: 50%;
    background: var(--accent); margin-right: 8px;
    box-shadow: 0 0 0 4px rgba(255,59,59,.18);
    animation: pulse 2.4s ease-in-out infinite;
    vertical-align: middle;
  }
  .title-card .sub {
    color: var(--muted); font-size: 12px; margin-top: 2px;
    font-variant-numeric: tabular-nums;
  }

  .stat-strip {
    display: flex; gap: 8px; pointer-events: auto;
  }
  .stat-tile {
    background: rgba(20,28,38,.92);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 14px;
    min-width: 110px;
  }
  .stat-tile .v {
    font-size: 22px; font-weight: 700; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat-tile .v.alert { color: var(--accent); }
  .stat-tile .v.warn  { color: var(--accent-2); }
  .stat-tile .k {
    color: var(--muted); font-size: 10px; text-transform: uppercase;
    letter-spacing: 0.08em; margin-top: 4px;
  }

  /* Data-freshness badges — every counter block is stamped with how old its
     figure is, so a frozen number can never masquerade as live. */
  .age-badge {
    display: inline-block; font-size: 11px; font-weight: 600;
    letter-spacing: 0.02em; padding: 2px 8px; border-radius: 999px;
    border: 1px solid var(--line); color: var(--muted);
    background: rgba(20,28,38,.6); white-space: nowrap;
  }
  .age-badge.fresh {
    color: #b6e56a; border-color: #3a4a1e; background: rgba(132,204,22,0.10);
  }
  .age-badge.stale {
    color: var(--accent-2); border-color: #4a3a1e; background: rgba(255,184,77,0.10);
  }

  .legend {
    background: rgba(20,28,38,.92);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    color: var(--muted); font-size: 11px;
    pointer-events: auto;
  }
  .legend .row { display: flex; align-items: center; gap: 8px; }
  .legend .row + .row { margin-top: 4px; }
  .legend .swatch {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(255,59,59,.25);
  }
  .legend .swatch.arc {
    width: 18px; height: 2px; border-radius: 0;
    background: var(--accent-2); box-shadow: none;
  }

  /* Pulse marker (HTML divIcon). Color overridable via --pc on the
     element (used for non-hantavirus outbreak markers). */
  .pulse-marker {
    position: relative;
    width: 14px; height: 14px;
    --pc: var(--accent);
  }
  .pulse-marker .core {
    position: absolute; inset: 0; margin: auto;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--pc);
    box-shadow: 0 0 8px var(--pc);
  }
  .pulse-marker .ring {
    position: absolute; inset: -8px; border-radius: 50%;
    border: 2px solid var(--pc);
    opacity: 0;
    animation: ring 2.2s ease-out infinite;
  }
  .pulse-marker.large .core {
    width: 14px; height: 14px;
    box-shadow: 0 0 14px rgba(255,59,59,1);
  }
  .pulse-marker.large .ring { inset: -12px; border-width: 3px; }
  @keyframes ring {
    0%   { transform: scale(0.4); opacity: 0.9; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  /* Ship marker — orange-ringed pulse with a ship glyph */
  .ship-marker {
    position: relative;
    width: 28px; height: 28px;
  }
  .ship-marker .body {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255, 184, 77, 0.95);
    color: #1a1208;
    border-radius: 50%;
    border: 2px solid #fff;
    box-shadow: 0 0 12px rgba(255, 184, 77, 0.85);
    font-size: 16px; font-weight: 900;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    line-height: 1;
  }
  .ship-marker .ring {
    position: absolute; inset: -10px; border-radius: 50%;
    border: 2px solid #ffb84d;
    opacity: 0;
    animation: ring 2.6s ease-out infinite;
  }
  .legend .swatch.ship {
    background: #ffb84d; border: 2px solid #fff;
    box-shadow: 0 0 6px rgba(255,184,77,.7);
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(255,59,59,.18); }
    50%      { box-shadow: 0 0 0 10px rgba(255,59,59,0); }
  }

  /* Animated dashed spread arcs */
  @keyframes dash {
    to { stroke-dashoffset: -40; }
  }
  .leaflet-overlay-pane path.spread-arc {
    stroke: var(--accent-2);
    stroke-width: 2;
    stroke-dasharray: 6 6;
    fill: none;
    opacity: 0.85;
    animation: dash 1.6s linear infinite;
  }

  /* Popup styling */
  .leaflet-popup-content-wrapper {
    background: #131a23 !important;
    color: var(--ink) !important;
    border: 1px solid var(--line) !important;
    border-radius: 10px !important;
  }
  .leaflet-popup-tip { background: #131a23 !important; border: 1px solid var(--line) !important; }
  .leaflet-popup-content { margin: 12px 14px !important; min-width: 240px; }
  .popup-title {
    font-weight: 700; font-size: 15px; margin-bottom: 6px;
    color: var(--accent-2); text-transform: uppercase; letter-spacing: 0.04em;
  }
  .popup-meta { color: var(--muted); font-size: 11px; margin-bottom: 8px; }
  .popup-list { padding: 0; margin: 0; list-style: none; }
  .popup-list li { padding: 6px 0; border-top: 1px solid var(--line); font-size: 12px; }
  .popup-list li:first-child { border-top: 0; }
  .popup-list .src { color: var(--good); font-size: 10px; text-transform: uppercase; }

  /* ---------- BELOW-MAP CONTENT ---------- */
  .wrap { max-width: 1100px; margin: 0 auto; padding: 28px 20px 80px; }
  .grid { display: grid; gap: 18px; grid-template-columns: repeat(12, 1fr); }
  .card {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 12px; padding: 18px 20px;
  }
  .card h2 {
    margin: 0 0 12px; font-size: 14px; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--muted);
  }
  .span-12 { grid-column: span 12; }
  .span-8  { grid-column: span 8; }
  .span-4  { grid-column: span 4; }
  @media (max-width: 800px) {
    .span-8, .span-4 { grid-column: span 12; }
    .stat-strip { flex-wrap: wrap; }
    .stat-tile { min-width: 95px; padding: 8px 10px; }
    .stat-tile .v { font-size: 18px; }
    .hero { height: 60vh; min-height: 420px; }
    .hud-bl { display: none; }
  }

  ul.items { list-style: none; padding: 0; margin: 0; }
  ul.items li { padding: 10px 0; border-bottom: 1px solid var(--line); }
  ul.items li:last-child { border-bottom: 0; }
  ul.items .title { font-weight: 600; line-height: 1.35; }
  ul.items .row {
    display: flex; gap: 8px; align-items: center; margin-top: 4px;
    color: var(--muted); font-size: 12px; flex-wrap: wrap;
  }
  ul.items .src { color: var(--good); }
  ul.items .src.promed { color: var(--accent-2); }
  ul.items .src.ecdc { color: var(--accent-3); }

  .stats-mini { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .stats-mini .stat { background: var(--panel-2); border-radius: 10px; padding: 12px 14px; }
  .stats-mini .v { font-size: 22px; font-weight: 700; }
  .stats-mini .k { color: var(--muted); font-size: 12px; text-transform: uppercase;
                   letter-spacing: 0.06em; margin-top: 2px; }

  footer {
    margin-top: 40px; color: var(--muted); font-size: 12px;
    border-top: 1px solid var(--line); padding-top: 16px;
  }
  footer a { color: var(--muted); text-decoration: underline; }

  /* ---------- Other-outbreaks sidebar ---------- */
  .sidebar {
    position: fixed; top: 80px; right: 14px; z-index: 600;
    width: 320px; max-height: calc(100vh - 100px);
    background: rgba(20,28,38,.96);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform .25s ease, opacity .2s ease;
    box-shadow: 0 8px 24px rgba(0,0,0,.4);
  }
  .sidebar.collapsed {
    transform: translateX(calc(100% + 24px));
    opacity: 0; pointer-events: none;
  }
  .sidebar .sb-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px; border-bottom: 1px solid var(--line);
    background: linear-gradient(135deg, rgba(255,184,77,.10), rgba(255,59,59,.06));
  }
  .sidebar .sb-head h3 {
    margin: 0; font-size: 12px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent-2);
  }
  .sidebar .sb-nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 6px 10px; border-bottom: 1px solid var(--line);
    background: rgba(255,255,255,.02);
  }
  .sidebar .sb-arrow {
    background: transparent; border: 0; color: var(--muted);
    font-size: 18px; line-height: 1; cursor: pointer;
    padding: 4px 10px; border-radius: 6px;
    transition: color .15s ease, background .15s ease;
  }
  .sidebar .sb-arrow:hover:not(:disabled) {
    color: var(--ink); background: rgba(255,255,255,.06);
  }
  .sidebar .sb-arrow:disabled { opacity: 0.25; cursor: not-allowed; }
  .sidebar .sb-dots {
    display: flex; gap: 6px; align-items: center;
    font-size: 10px; color: var(--muted); letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .sidebar .sb-dots .d {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--muted); opacity: 0.25;
    transition: opacity .15s ease, background .15s ease;
    cursor: pointer;
  }
  .sidebar .sb-dots .d.active { opacity: 1; }
  .sidebar .sb-dots .d:hover { opacity: 0.6; }
  .sidebar .sb-body { overflow-y: auto; padding: 12px 14px; }
  .sidebar .ob { display: none; }
  .sidebar .ob.active { display: block; }
  .sidebar .ob-name {
    font-size: 15px; font-weight: 700; color: var(--ink);
    display: flex; align-items: center; gap: 8px;
  }
  .sidebar .ob-dot {
    display: inline-block; width: 9px; height: 9px; border-radius: 50%;
    box-shadow: 0 0 8px currentColor;
  }
  .sidebar .ob-badge {
    margin-left: auto; font-size: 9px; font-weight: 600;
    padding: 2px 6px; border-radius: 10px; letter-spacing: 0.04em;
    text-transform: uppercase; line-height: 1;
  }
  .sidebar .ob-badge.live {
    color: var(--good); background: rgba(88,200,151,0.10);
    border: 1px solid rgba(88,200,151,0.35);
  }
  .sidebar .ob-region {
    color: var(--muted); font-size: 11px; margin-top: 2px;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .sidebar .ob-blurb {
    color: var(--muted); font-size: 12px; margin-top: 6px; line-height: 1.5;
  }
  .sidebar .ob-tickers {
    display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
    margin-top: 8px;
  }
  .sidebar .ob-tick { display: inline-flex; align-items: baseline; gap: 4px; }
  .sidebar .ob-tick .v {
    font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums;
  }
  .sidebar .ob-tick .k {
    color: var(--muted); font-size: 10px; text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .sidebar .ob-asof {
    color: var(--muted); font-size: 10px; flex-basis: 100%; opacity: 0.75;
  }
  .sidebar .ob-asof a { color: var(--muted); text-decoration: underline; }
  .sidebar .ob ul {
    list-style: none; padding: 0; margin: 8px 0 0;
  }
  .sidebar .ob li { padding: 5px 0; font-size: 12px; line-height: 1.4; }
  .sidebar .ob li .meta { color: var(--muted); font-size: 10px; }
  .sidebar .ob-empty {
    color: var(--muted); font-size: 11px; font-style: italic;
    margin-top: 8px; opacity: 0.7;
  }

  .sidebar-toggle {
    position: fixed; top: 80px; right: 14px; z-index: 601;
    background: rgba(20,28,38,.92);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 14px;
    color: var(--ink); font-size: 12px;
    letter-spacing: 0.06em; text-transform: uppercase;
    cursor: pointer; display: none;
    transition: background .15s ease;
  }
  .sidebar-toggle:hover { background: rgba(30,40,52,.96); }
  .sidebar-toggle .pill {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent-2); margin-right: 6px;
    box-shadow: 0 0 6px rgba(255,184,77,.7);
  }
  body.sidebar-off .sidebar { transform: translateX(calc(100% + 24px)); opacity: 0; pointer-events: none; }
  body.sidebar-off .sidebar-toggle { display: inline-block; }

  /* ----- Per-outbreak filter bar (bottom-center, above the hint) ----- */
  .ob-filterbar {
    position: absolute; left: 50%; bottom: 56px; transform: translateX(-50%);
    z-index: 602; display: flex; gap: 6px; flex-wrap: wrap;
    background: rgba(20,28,38,.78); border: 1px solid var(--line);
    border-radius: 999px; padding: 5px 7px;
    backdrop-filter: blur(4px);
    max-width: calc(100vw - 32px);
  }
  .ob-chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 11px; border-radius: 999px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase; cursor: pointer;
    background: transparent; color: var(--ink);
    border: 1px solid transparent;
    transition: background .15s ease, opacity .15s ease;
    user-select: none;
  }
  .ob-chip .chip-dot {
    width: 8px; height: 8px; border-radius: 50%;
    box-shadow: 0 0 6px currentColor;
  }
  .ob-chip:hover { background: rgba(255,255,255,.05); }
  .ob-chip.off { opacity: 0.4; }
  .ob-chip.off .chip-dot { box-shadow: none; opacity: 0.5; }
  .ob-chip.off .chip-name { text-decoration: line-through; }
  body.sidebar-off .ob-filterbar { display: none; }
  @media (max-width: 900px) { .ob-filterbar { display: none !important; } }

  .sb-close {
    background: transparent; border: 0; color: var(--muted);
    font-size: 18px; line-height: 1; cursor: pointer; padding: 4px 6px;
    border-radius: 6px;
  }
  .sb-close:hover { color: var(--ink); background: rgba(255,255,255,.06); }

  @media (max-width: 900px) {
    .sidebar, .sidebar-toggle { display: none !important; }
  }
</style>
