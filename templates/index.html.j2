<script>
  // Server-rendered data dump for the map.
  window.HANTA = {
    countries: {{ country_index_json|safe }},
    arcs:      {{ spread_arcs_json|safe }},
    vessel:    {{ vessel_json|safe }},
    other:     {{ other_outbreaks_json|safe }},
    hero:      {{ hero_json|safe }}
  };
</script>
<script>
(() => {
  const map = L.map('map', {
    zoomControl: true,
    attributionControl: true,
    worldCopyJump: true,
    minZoom: 2,
    maxZoom: 6,
    maxBounds: [[-72, -200], [82, 200]],
  }).setView([20, 0], 2);

  // Satellite imagery — clearly a globe (matches the Plague Inc. vibe).
  L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    {
      attribution: 'Tiles © Esri — Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, GIS User Community',
      maxZoom: 18,
    }
  ).addTo(map);

  // Country boundaries + labels overlay so countries are unmistakable.
  L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
    {
      attribution: '',
      maxZoom: 18,
      opacity: 0.85,
    }
  ).addTo(map);

  // Subtle dark wash so red markers pop against bright satellite imagery.
  const tint = L.rectangle(
    [[-90, -360], [90, 360]],
    { color: '#000', fillColor: '#0a1828', fillOpacity: 0.25, weight: 0,
      interactive: false }
  ).addTo(map);

  // ----- Markers -----
  const maxCount = Math.max(1, ...window.HANTA.countries.map(c => c.count));

  const escape = s => String(s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  })[c]);

  const popupHtml = (c) => {
    const items = c.items.map(i => `
      <li>
        <div class="src">${escape(i.source)} · ${escape(i.published || '')}</div>
        <a href="${escape(i.url)}" target="_blank" rel="noopener">${escape(i.title)}</a>
      </li>`).join('');
    return `
      <div class="popup-title">${escape(c.country)}</div>
      <div class="popup-meta">${c.count} reports · last ${escape(c.latest_date || '')}</div>
      <ul class="popup-list">${items}</ul>`;
  };

  window.HANTA.countries.forEach(c => {
    const big = c.count >= Math.max(3, maxCount * 0.5);
    const icon = L.divIcon({
      className: '',
      html: `<div class="pulse-marker ${big ? 'large' : ''}">
               <div class="ring"></div><div class="core"></div>
             </div>`,
      iconSize: [14, 14],
      iconAnchor: [7, 7],
    });
    L.marker([c.lat, c.lng], { icon, title: `${c.country} · ${c.count} reports` })
      .bindPopup(popupHtml(c), { maxWidth: 320 })
      .addTo(map);
  });

  // ----- Spread arcs (great-circle approximation) -----
  const greatCircle = (a, b, segs = 64) => {
    // Convert to radians
    const toRad = d => d * Math.PI / 180;
    const toDeg = r => r * 180 / Math.PI;
    const [lat1, lon1] = a.map(toRad);
    const [lat2, lon2] = b.map(toRad);
    const d = 2 * Math.asin(Math.sqrt(
      Math.sin((lat2 - lat1)/2) ** 2 +
      Math.cos(lat1) * Math.cos(lat2) * Math.sin((lon2 - lon1)/2) ** 2
    ));
    if (d === 0) return [a, b];
    const pts = [];
    for (let i = 0; i <= segs; i++) {
      const f = i / segs;
      const A = Math.sin((1 - f) * d) / Math.sin(d);
      const B = Math.sin(f * d) / Math.sin(d);
      const x = A * Math.cos(lat1) * Math.cos(lon1) + B * Math.cos(lat2) * Math.cos(lon2);
      const y = A * Math.cos(lat1) * Math.sin(lon1) + B * Math.cos(lat2) * Math.sin(lon2);
      const z = A * Math.sin(lat1) + B * Math.sin(lat2);
      const lat = Math.atan2(z, Math.sqrt(x*x + y*y));
      const lon = Math.atan2(y, x);
      pts.push([toDeg(lat), toDeg(lon)]);
    }
    return pts;
  };

  window.HANTA.arcs.forEach(arc => {
    const path = greatCircle(arc.from_latlng, arc.to_latlng);
    L.polyline(path, { className: 'spread-arc' })
      .bindTooltip(`${arc.from} → ${arc.to}<br><span style="color:#8a99ab">${arc.label}</span>`, {
        direction: 'top', sticky: true, opacity: 0.95,
      })
      .addTo(map);
  });

  // ----- MV Hondius live position -----
  if (window.HANTA.vessel && window.HANTA.vessel.position) {
    const v = window.HANTA.vessel;
    const p = v.position;
    if (Array.isArray(v.track) && v.track.length >= 2) {
      const trackPoints = v.track.map(t => [t.lat, t.lng]);
      L.polyline(trackPoints, {
        color: '#ffb84d',
        weight: 2,
        opacity: 0.7,
        dashArray: '4 5',
        className: 'ship-track',
      }).addTo(map);
    }
    const shipIcon = L.divIcon({
      className: '',
      html: `<div class="ship-marker"
                  ${p.heading_deg != null
                    ? `style="transform: rotate(${p.heading_deg}deg)"` : ''}>
               <div class="ring"></div><div class="body">⚓</div>
             </div>`,
      iconSize: [28, 28],
      iconAnchor: [14, 14],
    });
    const fetched = p.fetched_at
      ? new Date(p.fetched_at).toUTCString().replace('GMT', 'UTC')
      : '';
    const heading = p.heading_deg != null
      ? `${Math.round(p.heading_deg)}°` : '—';
    L.marker([p.lat, p.lng], {
      icon: shipIcon,
      title: `${v.name} · last AIS ${fetched}`,
      zIndexOffset: 1000,
    })
      .bindPopup(`
        <div class="popup-title">${escape(v.name)}</div>
        <div class="popup-meta">
          ${escape(v.operator)} · IMO ${escape(v.imo)} · MMSI ${escape(v.mmsi)}
        </div>
        <div style="font-size: 12px; line-height: 1.6;">
          <div><strong>Position:</strong> ${p.lat.toFixed(3)}°,
            ${p.lng.toFixed(3)}°</div>
          <div><strong>Heading:</strong> ${heading}</div>
          <div><strong>Last AIS fix:</strong> ${escape(fetched)}</div>
          <div><strong>Departed:</strong>
            ${escape(v.departed_from)} · ${escape(v.departed_at)}</div>
          <div style="margin-top: 8px;">
            <a href="${escape(v.tracker_url)}" target="_blank" rel="noopener">
              CruiseMapper</a> ·
            <a href="${escape(v.vesselfinder_url)}" target="_blank" rel="noopener">
              VesselFinder</a> ·
            <a href="${escape(v.marinetraffic_url)}" target="_blank" rel="noopener">
              MarineTraffic</a>
          </div>
        </div>
      `, { maxWidth: 320 })
      .addTo(map);
  }

  // ----- Hero outbreak map markers (cyclosporiasis US states) -----
  const hero = window.HANTA.hero;
  if (hero && Array.isArray(hero.locations)) {
    const hColor = hero.color || '#84cc16';
    const heroNews = (hero.news || []).slice(0, 3).map(i => `
      <li>
        <div class="src" style="color:${hColor}">${escape(i.source)}${i.published ? ' · ' + escape(i.published) : ''}</div>
        <a href="${escape(i.url)}" target="_blank" rel="noopener">${escape(i.title)}</a>
      </li>`).join('');
    const heroAge = hero.data_age && hero.data_age.human ? hero.data_age.human : '';
    hero.locations.forEach(loc => {
      const icon = L.divIcon({
        className: '',
        html: `<div class="pulse-marker large" style="--pc: ${hColor}">
                 <div class="ring"></div><div class="core"></div>
               </div>`,
        iconSize: [14, 14],
        iconAnchor: [7, 7],
      });
      L.marker([loc.lat, loc.lng], { icon, title: `${hero.name} · ${loc.name}` })
        .bindPopup(`
          <div class="popup-title" style="color:${hColor}">${escape(hero.name)} — ${escape(loc.name)}</div>
          <div class="popup-meta">${escape(hero.region)}${heroAge ? ' · ' + escape(heroAge) : ''}</div>
          <div style="display:flex; gap:14px; align-items:baseline; margin:4px 0 8px;">
            <div><span style="font-size:18px;font-weight:700;font-variant-numeric:tabular-nums;color:${hColor}">${(hero.confirmed || 0).toLocaleString()}</span>
              <span style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em"> confirmed (US)</span></div>
            <div><span style="font-size:18px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--accent-2)">${(hero.hospitalized || 0).toLocaleString()}</span>
              <span style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em"> hospitalized</span></div>
          </div>
          <div style="font-size:12px; color: var(--muted); margin-bottom: 6px;">${escape(hero.blurb || '')}</div>
          ${heroNews ? `<ul class="popup-list">${heroNews}</ul>` : ''}
        `, { maxWidth: 320 })
        .addTo(map);
    });
  }

  // ----- Other-outbreak map markers (colored pulses per disease) -----
  // One LayerGroup per outbreak so the top-of-map filter chips can toggle
  // them independently. The sidebar close button still hides all of them.
  const otherLayers = {};  // key -> L.LayerGroup
  (window.HANTA.other || []).forEach(ob => {
    const color = ob.color || '#c084fc';
    const layer = L.layerGroup();
    otherLayers[ob.key] = layer;
    (ob.locations || []).forEach(loc => {
      const icon = L.divIcon({
        className: '',
        html: `<div class="pulse-marker large" style="--pc: ${color}">
                 <div class="ring"></div><div class="core"></div>
               </div>`,
        iconSize: [14, 14],
        iconAnchor: [7, 7],
      });
      const newsHtml = (ob.news || []).slice(0, 3).map(i => `
        <li>
          <div class="src" style="color:${color}">${escape(i.source)}${i.published ? ' · ' + escape(i.published) : ''}</div>
          <a href="${escape(i.url)}" target="_blank" rel="noopener">${escape(i.title)}</a>
        </li>`).join('');
      const tickerHtml = (ob.status === 'live' && (ob.cases != null || ob.deaths != null)) ? `
        <div style="display:flex; gap:14px; align-items:baseline; margin: 4px 0 8px;">
          ${ob.cases != null ? `
            <div><span style="font-size:18px;font-weight:700;font-variant-numeric:tabular-nums;color:${color}">${ob.cases.toLocaleString()}</span>
            <span style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em"> cases</span></div>` : ''}
          ${ob.deaths != null ? `
            <div><span style="font-size:18px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--alert)">${ob.deaths.toLocaleString()}</span>
            <span style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em"> deaths</span></div>` : ''}
          ${ob.as_of ? `<div style="font-size:10px;color:var(--muted);align-self:flex-end">as of ${escape(ob.as_of)}</div>` : ''}
        </div>` : '';
      L.marker([loc.lat, loc.lng], {
        icon,
        title: `${ob.name} · ${loc.name}`,
      })
        .bindPopup(`
          <div class="popup-title" style="color:${color}">${escape(ob.name)} — ${escape(loc.name)}</div>
          <div class="popup-meta">${escape(ob.region)} · since ${escape(ob.started)}</div>
          ${tickerHtml}
          <div style="font-size:12px; color: var(--muted); margin-bottom: 6px;">
            ${escape(ob.blurb)}
          </div>
          ${newsHtml ? `<ul class="popup-list">${newsHtml}</ul>` : ''}
        `, { maxWidth: 320 })
        .addTo(layer);
    });
  });

  const isOutbreakOff = key => {
    try { return localStorage.getItem(`hanta:ob:${key}`) === 'off'; }
    catch (e) { return false; }
  };
  const setOutbreakOff = (key, off) => {
    try { localStorage.setItem(`hanta:ob:${key}`, off ? 'off' : 'on'); }
    catch (e) {}
  };

  const applyOtherLayer = () => {
    const sidebarOff = document.body.classList.contains('sidebar-off');
    Object.entries(otherLayers).forEach(([key, layer]) => {
      if (sidebarOff || isOutbreakOff(key)) {
        map.removeLayer(layer);
      } else {
        layer.addTo(map);
      }
    });
  };

  // ----- Carousel state — sidebar shows one outbreak at a time -----
  const obKeys = Array.from(document.querySelectorAll('.sidebar .ob'))
    .map(el => el.dataset.obKey);
  const enabledKeys = () => obKeys.filter(k => !isOutbreakOff(k));
  let activeKey = enabledKeys()[0] || obKeys[0] || null;

  const refreshChip = (key) => {
    const off = isOutbreakOff(key);
    const chip = document.querySelector(`.ob-chip[data-ob-key="${key}"]`);
    if (chip) chip.classList.toggle('off', off);
  };

  const refreshCarousel = () => {
    const enabled = enabledKeys();
    // If active key is now disabled, pick the next enabled one.
    if (activeKey && !enabled.includes(activeKey)) {
      activeKey = enabled[0] || null;
    }
    // Sidebar entries: show only the active one.
    document.querySelectorAll('.sidebar .ob').forEach(el => {
      el.classList.toggle('active', el.dataset.obKey === activeKey);
    });
    // Dots: hide ones whose outbreak is filtered off; mark active.
    document.querySelectorAll('.sb-dots .d').forEach(el => {
      const key = el.dataset.obKey;
      const off = isOutbreakOff(key);
      el.style.display = off ? 'none' : '';
      el.style.background = off
        ? 'var(--muted)'
        : (document.querySelector(`.ob-chip[data-ob-key="${key}"] .chip-dot`)
            ?.style.background || 'var(--ink)');
      el.classList.toggle('active', key === activeKey);
    });
    // Arrows: disable when 0 or 1 enabled outbreaks.
    const navHidden = enabled.length < 2;
    const prev = document.getElementById('sbPrev');
    const next = document.getElementById('sbNext');
    if (prev) prev.disabled = navHidden;
    if (next) next.disabled = navHidden;
    // Whole nav row: hide if no enabled outbreaks (sidebar would be empty too).
    const nav = document.getElementById('sbNav');
    if (nav) nav.style.display = enabled.length === 0 ? 'none' : '';
  };

  const advance = (delta) => {
    const enabled = enabledKeys();
    if (enabled.length === 0) return;
    let idx = enabled.indexOf(activeKey);
    if (idx === -1) idx = 0;
    idx = (idx + delta + enabled.length) % enabled.length;
    activeKey = enabled[idx];
    refreshCarousel();
  };

  obKeys.forEach(refreshChip);
  refreshCarousel();

  document.querySelectorAll('.ob-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.obKey;
      const turningOn = isOutbreakOff(key);  // about to flip to on
      setOutbreakOff(key, !isOutbreakOff(key));
      refreshChip(key);
      // If we just turned an outbreak on, jump the sidebar to it.
      if (turningOn) activeKey = key;
      refreshCarousel();
      applyOtherLayer();
    });
  });

  document.getElementById('sbPrev')?.addEventListener('click', () => advance(-1));
  document.getElementById('sbNext')?.addEventListener('click', () => advance(+1));
  document.querySelectorAll('.sb-dots .d').forEach(d => {
    d.addEventListener('click', () => {
      const key = d.dataset.obKey;
      if (isOutbreakOff(key)) return;
      activeKey = key;
      refreshCarousel();
    });
  });
  // Keyboard: left/right arrow keys cycle when the sidebar is focused/visible.
  document.addEventListener('keydown', (e) => {
    if (document.body.classList.contains('sidebar-off')) return;
    if (e.target.matches('input, textarea')) return;
    if (e.key === 'ArrowLeft')  advance(-1);
    if (e.key === 'ArrowRight') advance(+1);
  });

  applyOtherLayer();

  // ----- Other-outbreaks sidebar toggle (localStorage-persisted) -----
  document.getElementById('sbClose')?.addEventListener('click', () => {
    document.body.classList.add('sidebar-off');
    try { localStorage.setItem('hanta:sidebar', 'off'); } catch (e) {}
    applyOtherLayer();
  });
  document.getElementById('sbToggle')?.addEventListener('click', () => {
    document.body.classList.remove('sidebar-off');
    try { localStorage.setItem('hanta:sidebar', 'on'); } catch (e) {}
    applyOtherLayer();
  });

  // Fit to data bounds if any markers, else default world view.
  const allPoints = [
    ...window.HANTA.countries.map(c => [c.lat, c.lng]),
  ];
  if (window.HANTA.vessel && window.HANTA.vessel.position) {
    allPoints.push([
      window.HANTA.vessel.position.lat,
      window.HANTA.vessel.position.lng,
    ]);
  }
  if (allPoints.length) {
    const bounds = L.latLngBounds(allPoints);
    map.fitBounds(bounds.pad(0.4), { maxZoom: 3 });
  }
})();
</script>
</body>
</html>
