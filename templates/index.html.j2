<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hantavirus Tracker — live global outbreak map</title>
<meta name="description" content="Live, hourly-updated map of hantavirus outbreaks and news from ProMED-mail, Google News, and CDC surveillance. Track active clusters, recent reports, and documented spread routes.">
<link rel="canonical" href="{{ site_url }}/">
<meta property="og:title" content="Hantavirus Tracker — live global outbreak map">
<meta property="og:description" content="Live, hourly-updated map of hantavirus outbreaks and news from ProMED-mail, Google News, and CDC.">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site_url }}/">
<meta property="og:image" content="{{ site_url }}/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Hantavirus Tracker">
<meta name="twitter:description" content="Live global map of hantavirus outbreaks and news.">
<meta name="twitter:image" content="{{ site_url }}/og.png">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><text y=%2250%22 font-size=%2256%22>&#129440;</text></svg>">
{% if analytics_code %}
<script data-goatcounter="https://{{ analytics_code }}.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
{% endif %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>
<style>
  :root {
    --bg: #0a0e14;
    --panel: #131a23;
    --panel-2: #1d2632;
    --ink: #e8eef5;
    --muted: #8a99ab;
    --accent: #ff3b3b;
    --accent-2: #ffb84d;
    --accent-3: #6db8ff;
    --good: #58c897;
    --line: #28323e;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: #7cc1ff; text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* ---------- HERO MAP ---------- */
  .hero {
    position: relative;
    height: 70vh;
    min-height: 520px;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  #map {
    height: 100%; width: 100%;
    background: #0a1828;
  }
  .leaflet-container { background: #0a1828; outline: none; }
  .leaflet-control-attribution {
    background: rgba(10,14,20,.7) !important;
    color: #6b7785 !important;
    font-size: 10px !important;
  }
  .leaflet-control-attribution a { color: #8a99ab !important; }
  .leaflet-control-zoom a {
    background: rgba(20,28,38,.85) !important;
    color: #e8eef5 !important;
    border: 1px solid var(--line) !important;
  }

  /* HUD overlays */
  .hud {
    position: absolute; pointer-events: none; z-index: 500;
  }
  .hud-tl { top: 14px; left: 14px; }
  .hud-tr { top: 14px; right: 14px; }
  .hud-bl { bottom: 14px; left: 14px; }
  .hud-br { bottom: 14px; right: 14px; }
  .hud-bc {
    bottom: 14px; left: 50%; transform: translateX(-50%);
    color: var(--muted); font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(10,14,20,.6); padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--line);
  }

  .title-card {
    background: linear-gradient(135deg, rgba(20,28,38,.92), rgba(15,20,28,.85));
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 16px;
    pointer-events: auto;
  }
  .title-card h1 {
    margin: 0; font-size: 18px; letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .title-card h1 .dot {
    display: inline-block; width: 9px; height: 9px; border-radius: 50%;
    background: var(--accent); margin-right: 8px;
    box-shadow: 0 0 0 4px rgba(255,59,59,.18);
    animation: pulse 2.4s ease-in-out infinite;
    vertical-align: middle;
  }
  .title-card .sub {
    color: var(--muted); font-size: 12px; margin-top: 2px;
    font-variant-numeric: tabular-nums;
  }

  .stat-strip {
    display: flex; gap: 8px; pointer-events: auto;
  }
  .stat-tile {
    background: rgba(20,28,38,.92);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 14px;
    min-width: 110px;
  }
  .stat-tile .v {
    font-size: 22px; font-weight: 700; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat-tile .v.alert { color: var(--accent); }
  .stat-tile .v.warn  { color: var(--accent-2); }
  .stat-tile .k {
    color: var(--muted); font-size: 10px; text-transform: uppercase;
    letter-spacing: 0.08em; margin-top: 4px;
  }

  .legend {
    background: rgba(20,28,38,.92);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    color: var(--muted); font-size: 11px;
    pointer-events: auto;
  }
  .legend .row { display: flex; align-items: center; gap: 8px; }
  .legend .row + .row { margin-top: 4px; }
  .legend .swatch {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(255,59,59,.25);
  }
  .legend .swatch.arc {
    width: 18px; height: 2px; border-radius: 0;
    background: var(--accent-2); box-shadow: none;
  }

  /* Pulse marker (HTML divIcon). Color overridable via --pc on the
     element (used for non-hantavirus outbreak markers). */
  .pulse-marker {
    position: relative;
    width: 14px; height: 14px;
    --pc: var(--accent);
  }
  .pulse-marker .core {
    position: absolute; inset: 0; margin: auto;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--pc);
    box-shadow: 0 0 8px var(--pc);
  }
  .pulse-marker .ring {
    position: absolute; inset: -8px; border-radius: 50%;
    border: 2px solid var(--pc);
    opacity: 0;
    animation: ring 2.2s ease-out infinite;
  }
  .pulse-marker.large .core {
    width: 14px; height: 14px;
    box-shadow: 0 0 14px rgba(255,59,59,1);
  }
  .pulse-marker.large .ring { inset: -12px; border-width: 3px; }
  @keyframes ring {
    0%   { transform: scale(0.4); opacity: 0.9; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  /* Ship marker — orange-ringed pulse with a ship glyph */
  .ship-marker {
    position: relative;
    width: 28px; height: 28px;
  }
  .ship-marker .body {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255, 184, 77, 0.95);
    color: #1a1208;
    border-radius: 50%;
    border: 2px solid #fff;
    box-shadow: 0 0 12px rgba(255, 184, 77, 0.85);
    font-size: 16px; font-weight: 900;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    line-height: 1;
  }
  .ship-marker .ring {
    position: absolute; inset: -10px; border-radius: 50%;
    border: 2px solid #ffb84d;
    opacity: 0;
    animation: ring 2.6s ease-out infinite;
  }
  .legend .swatch.ship {
    background: #ffb84d; border: 2px solid #fff;
    box-shadow: 0 0 6px rgba(255,184,77,.7);
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(255,59,59,.18); }
    50%      { box-shadow: 0 0 0 10px rgba(255,59,59,0); }
  }

  /* Animated dashed spread arcs */
  @keyframes dash {
    to { stroke-dashoffset: -40; }
  }
  .leaflet-overlay-pane path.spread-arc {
    stroke: var(--accent-2);
    stroke-width: 2;
    stroke-dasharray: 6 6;
    fill: none;
    opacity: 0.85;
    animation: dash 1.6s linear infinite;
  }

  /* Popup styling */
  .leaflet-popup-content-wrapper {
    background: #131a23 !important;
    color: var(--ink) !important;
    border: 1px solid var(--line) !important;
    border-radius: 10px !important;
  }
  .leaflet-popup-tip { background: #131a23 !important; border: 1px solid var(--line) !important; }
  .leaflet-popup-content { margin: 12px 14px !important; min-width: 240px; }
  .popup-title {
    font-weight: 700; font-size: 15px; margin-bottom: 6px;
    color: var(--accent-2); text-transform: uppercase; letter-spacing: 0.04em;
  }
  .popup-meta { color: var(--muted); font-size: 11px; margin-bottom: 8px; }
  .popup-list { padding: 0; margin: 0; list-style: none; }
  .popup-list li { padding: 6px 0; border-top: 1px solid var(--line); font-size: 12px; }
  .popup-list li:first-child { border-top: 0; }
  .popup-list .src { color: var(--good); font-size: 10px; text-transform: uppercase; }

  /* ---------- BELOW-MAP CONTENT ---------- */
  .wrap { max-width: 1100px; margin: 0 auto; padding: 28px 20px 80px; }
  .grid { display: grid; gap: 18px; grid-template-columns: repeat(12, 1fr); }
  .card {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 12px; padding: 18px 20px;
  }
  .card h2 {
    margin: 0 0 12px; font-size: 14px; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--muted);
  }
  .span-12 { grid-column: span 12; }
  .span-8  { grid-column: span 8; }
  .span-4  { grid-column: span 4; }
  @media (max-width: 800px) {
    .span-8, .span-4 { grid-column: span 12; }
    .stat-strip { flex-wrap: wrap; }
    .stat-tile { min-width: 95px; padding: 8px 10px; }
    .stat-tile .v { font-size: 18px; }
    .hero { height: 60vh; min-height: 420px; }
    .hud-bl { display: none; }
  }

  ul.items { list-style: none; padding: 0; margin: 0; }
  ul.items li { padding: 10px 0; border-bottom: 1px solid var(--line); }
  ul.items li:last-child { border-bottom: 0; }
  ul.items .title { font-weight: 600; line-height: 1.35; }
  ul.items .row {
    display: flex; gap: 8px; align-items: center; margin-top: 4px;
    color: var(--muted); font-size: 12px; flex-wrap: wrap;
  }
  ul.items .src { color: var(--good); }
  ul.items .src.promed { color: var(--accent-2); }
  ul.items .src.ecdc { color: var(--accent-3); }

  .stats-mini { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .stats-mini .stat { background: var(--panel-2); border-radius: 10px; padding: 12px 14px; }
  .stats-mini .v { font-size: 22px; font-weight: 700; }
  .stats-mini .k { color: var(--muted); font-size: 12px; text-transform: uppercase;
                   letter-spacing: 0.06em; margin-top: 2px; }

  footer {
    margin-top: 40px; color: var(--muted); font-size: 12px;
    border-top: 1px solid var(--line); padding-top: 16px;
  }
  footer a { color: var(--muted); text-decoration: underline; }

  /* ---------- Other-outbreaks sidebar ---------- */
  .sidebar {
    position: fixed; top: 80px; right: 14px; z-index: 600;
    width: 320px; max-height: calc(100vh - 100px);
    background: rgba(20,28,38,.96);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform .25s ease, opacity .2s ease;
    box-shadow: 0 8px 24px rgba(0,0,0,.4);
  }
  .sidebar.collapsed {
    transform: translateX(calc(100% + 24px));
    opacity: 0; pointer-events: none;
  }
  .sidebar .sb-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px; border-bottom: 1px solid var(--line);
    background: linear-gradient(135deg, rgba(255,184,77,.10), rgba(255,59,59,.06));
  }
  .sidebar .sb-head h3 {
    margin: 0; font-size: 12px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent-2);
  }
  .sidebar .sb-body { overflow-y: auto; padding: 10px 12px; }
  .sidebar .ob {
    padding: 10px 0; border-top: 1px solid var(--line);
  }
  .sidebar .ob:first-child { border-top: 0; padding-top: 4px; }
  .sidebar .ob-name {
    font-size: 15px; font-weight: 700; color: var(--ink);
  }
  .sidebar .ob-region {
    color: var(--muted); font-size: 11px; margin-top: 2px;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .sidebar .ob-blurb {
    color: var(--muted); font-size: 12px; margin-top: 6px; line-height: 1.5;
  }
  .sidebar .ob ul {
    list-style: none; padding: 0; margin: 8px 0 0;
  }
  .sidebar .ob li { padding: 5px 0; font-size: 12px; line-height: 1.4; }
  .sidebar .ob li .meta { color: var(--muted); font-size: 10px; }

  .sidebar-toggle {
    position: fixed; top: 80px; right: 14px; z-index: 601;
    background: rgba(20,28,38,.92);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 14px;
    color: var(--ink); font-size: 12px;
    letter-spacing: 0.06em; text-transform: uppercase;
    cursor: pointer; display: none;
    transition: background .15s ease;
  }
  .sidebar-toggle:hover { background: rgba(30,40,52,.96); }
  .sidebar-toggle .pill {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent-2); margin-right: 6px;
    box-shadow: 0 0 6px rgba(255,184,77,.7);
  }
  body.sidebar-off .sidebar { transform: translateX(calc(100% + 24px)); opacity: 0; pointer-events: none; }
  body.sidebar-off .sidebar-toggle { display: inline-block; }

  .sb-close {
    background: transparent; border: 0; color: var(--muted);
    font-size: 18px; line-height: 1; cursor: pointer; padding: 4px 6px;
    border-radius: 6px;
  }
  .sb-close:hover { color: var(--ink); background: rgba(255,255,255,.06); }

  @media (max-width: 900px) {
    .sidebar, .sidebar-toggle { display: none !important; }
  }
</style>
</head>
<body>
<script>
  // Apply sidebar visibility before rendering to avoid a flash.
  try {
    if (localStorage.getItem('hanta:sidebar') === 'off') {
      document.body.classList.add('sidebar-off');
    }
  } catch (e) {}
</script>

{% if other_outbreaks %}
<aside class="sidebar" id="otherOutbreaks">
  <div class="sb-head">
    <h3>Other active outbreaks</h3>
    <button class="sb-close" id="sbClose" title="Hide sidebar" aria-label="Hide sidebar">×</button>
  </div>
  <div class="sb-body">
    {% for ob in other_outbreaks %}
    <div class="ob">
      <div class="ob-name">{{ ob.name }}</div>
      <div class="ob-region">{{ ob.region }} · since {{ ob.started }}</div>
      <div class="ob-blurb">{{ ob.blurb }}</div>
      {% if ob.news %}
      <ul>
        {% for i in ob.news[:4] %}
        <li>
          <a href="{{ i.url }}" target="_blank" rel="noopener">{{ i.title|unescape }}</a>
          <div class="meta">{{ i.source }}{% if i.published %} · {{ i.published }}{% endif %}</div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</aside>
<button class="sidebar-toggle" id="sbToggle" title="Show other outbreaks">
  <span class="pill"></span>Other outbreaks
</button>
{% endif %}

<div class="hero">
  <div id="map"></div>

  <div class="hud hud-tl">
    <div class="title-card">
      <h1><span class="dot"></span>Hantavirus Tracker</h1>
      <div class="sub">Updated {{ build_time_human }} · rebuilds hourly</div>
    </div>
  </div>

  <div class="hud hud-tr">
    <div class="stat-strip">
      <div class="stat-tile"
           title="Hondius cluster — confirmed + suspected — WHO DON599">
        <div class="v warn">{{ vessel_counts.cases_total }}</div>
        <div class="k">Cases · Hondius</div>
      </div>
      <div class="stat-tile"
           title="Hondius cluster fatalities — WHO DON599">
        <div class="v alert">{{ vessel_counts.deaths }}</div>
        <div class="k">Deaths · Hondius</div>
      </div>
      <div class="stat-tile"
           title="Active countries with reports in last 60 days">
        <div class="v">{{ active_country_count }}</div>
        <div class="k">Active countries</div>
      </div>
      <div class="stat-tile"
           title="US case fatality rate, all hantavirus 1993–2023">
        <div class="v alert">{{ cdc.case_fatality_rate_pct }}%</div>
        <div class="k">US CFR · CDC</div>
      </div>
    </div>
  </div>

  <div class="hud hud-bl">
    <div class="legend">
      <div class="row"><span class="swatch"></span>Reported activity (last 60d)</div>
      <div class="row"><span class="swatch arc"></span>Documented spread route</div>
      {% if vessel_position %}
      <div class="row"><span class="swatch ship"></span>MV Hondius (outbreak vessel)</div>
      {% endif %}
    </div>
  </div>

  <div class="hud hud-bc">
    Click a marker · drag to pan · scroll to zoom
  </div>
</div>

<div class="wrap">
  <div class="grid">
    {% if vessel_position %}
    <div class="card span-12" style="border-color: #4a3a1e;
         background: linear-gradient(135deg, #2a2113, #1a1812);">
      <h2 style="color: var(--accent-2);">Outbreak vessel · live counters</h2>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 14px;">
        <div class="stat-tile" style="background: rgba(255,184,77,0.08); border-color: #4a3a1e;">
          <div class="v warn">{{ vessel_counts.cases_total }}</div>
          <div class="k">Total cases</div>
        </div>
        <div class="stat-tile" style="background: rgba(88,200,151,0.08); border-color: #1e4a35;">
          <div class="v" style="color: var(--good);">{{ vessel_counts.cases_confirmed }}</div>
          <div class="k">Lab confirmed</div>
        </div>
        <div class="stat-tile" style="background: rgba(255,184,77,0.05); border-color: #3a2e1a;">
          <div class="v warn">{{ vessel_counts.cases_suspected }}</div>
          <div class="k">{% if vessel_counts.source == "ECDC" %}Probable{% else %}Suspected{% endif %}</div>
        </div>
        <div class="stat-tile" style="background: rgba(255,59,59,0.10); border-color: #4a1e22;">
          <div class="v alert">{{ vessel_counts.deaths }}</div>
          <div class="k">Deaths</div>
        </div>
        <div class="stat-tile" style="background: rgba(255,59,59,0.05); border-color: #3a1c1f;">
          <div class="v alert">{{ vessel_counts.critical }}</div>
          <div class="k">Critical</div>
        </div>
        <div class="stat-tile">
          <div class="v">{{ vessel_counts.on_board }}</div>
          <div class="k">On board ({{ vessel_counts.passengers }}+{{ vessel_counts.crew }})</div>
        </div>
      </div>

      <div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: baseline; margin-bottom: 10px;">
        <div style="flex: 1 1 240px;">
          <div style="font-size: 22px; font-weight: 700;">
            {{ vessel.name }}
          </div>
          <div style="color: var(--muted); font-size: 13px;">
            {{ vessel.operator }} · IMO {{ vessel.imo }} · MMSI {{ vessel.mmsi }}
            · flag {{ vessel.flag }}
          </div>
          <div style="color: var(--muted); font-size: 13px; margin-top: 4px;">
            Departed {{ vessel.departed_from }} on {{ vessel.departed_at }}.
          </div>
        </div>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <div>
            <div style="color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;">Position</div>
            <div style="font-size: 18px; font-variant-numeric: tabular-nums;">
              {{ "%.3f"|format(vessel_position.lat) }}°,
              {{ "%.3f"|format(vessel_position.lng) }}°
            </div>
          </div>
          {% if vessel_position.heading_deg is not none %}
          <div>
            <div style="color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;">Heading</div>
            <div style="font-size: 18px; font-variant-numeric: tabular-nums;">
              {{ vessel_position.heading_deg|round|int }}°
            </div>
          </div>
          {% endif %}
          <div>
            <div style="color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;">Last AIS fix</div>
            <div style="font-size: 13px; color: var(--good);">
              {{ vessel_position.fetched_at[:16].replace('T', ' ') }} UTC
            </div>
          </div>
        </div>
      </div>

      <div style="font-size: 12px; color: var(--muted);">
        Counters as of {{ vessel_counts.as_of }}, scraped from
        <a href="{{ vessel_counts.source_url }}" target="_blank" rel="noopener">{{ vessel_counts.source }}</a>.
        Position from
        <a href="{{ vessel.tracker_url }}" target="_blank" rel="noopener">CruiseMapper</a>;
        cross-check on
        <a href="{{ vessel.vesselfinder_url }}" target="_blank" rel="noopener">VesselFinder</a>
        / <a href="{{ vessel.marinetraffic_url }}" target="_blank" rel="noopener">MarineTraffic</a>.
        Refreshes hourly.
      </div>
    </div>
    {% endif %}

    <div class="card span-8">
      <h2>ProMED-mail · official outbreak alerts</h2>
      {% if promed_items %}
      <ul class="items">
        {% for item in promed_items %}
        <li>
          <div class="title">
            <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title|unescape }}</a>
          </div>
          <div class="row">
            <span class="src promed">{{ item.source }}</span>
            {% if item.published_human %}<span>·</span><span>{{ item.published_human }}</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div style="color: var(--muted);">No ProMED items fetched in this build.</div>
      {% endif %}
    </div>

    <div class="card span-4">
      <h2>CDC US snapshot</h2>
      <div class="stats-mini">
        <div class="stat"><div class="v">{{ cdc.total_cases }}</div>
          <div class="k">Total cases</div></div>
        <div class="stat"><div class="v">{{ cdc.case_fatality_rate_pct }}%</div>
          <div class="k">Fatality rate</div></div>
        <div class="stat"><div class="v">{{ cdc.hps_cases }}</div>
          <div class="k">HPS cases</div></div>
        <div class="stat"><div class="v">{{ cdc.pct_west_of_mississippi }}%</div>
          <div class="k">West of Miss.</div></div>
      </div>
      <p style="color: var(--muted); margin-top:12px; font-size: 12px;">
        Surveillance period {{ cdc.surveillance_start }} – {{ cdc.as_of[:4] }}.
        Median age {{ cdc.median_age }}, {{ cdc.pct_male }}% male.
        <a href="{{ cdc.source_url }}" target="_blank" rel="noopener">Source: CDC</a>.
      </p>
    </div>

    <div class="card span-12">
      <h2>ECDC · EU agency press releases &amp; assessments</h2>
      {% if ecdc_items %}
      <ul class="items">
        {% for item in ecdc_items %}
        <li>
          <div class="title">
            <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title|unescape }}</a>
          </div>
          <div class="row">
            <span class="src ecdc">{{ item.source }}</span>
            {% if item.published_human %}<span>·</span><span>{{ item.published_human }}</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div style="color: var(--muted);">No ECDC hantavirus items in this build.</div>
      {% endif %}
    </div>

    <div class="card span-12">
      <h2>News &amp; press · last {{ news_items|length }} items</h2>
      {% if news_items %}
      <ul class="items">
        {% for item in news_items %}
        <li>
          <div class="title">
            <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title|unescape }}</a>
          </div>
          <div class="row">
            <span class="src">{{ item.source }}</span>
            {% if item.published_human %}<span>·</span><span>{{ item.published_human }}</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>

  <footer>
    <a href="about.html">About / disclaimer</a> ·
    Sources: <a href="https://promedmail.org/?s=hantavirus" target="_blank" rel="noopener">ProMED-mail</a>,
    <a href="https://www.ecdc.europa.eu/en/infectious-disease-topics/hantavirus-infection" target="_blank" rel="noopener">ECDC</a>,
    <a href="https://news.google.com/search?q=hantavirus" target="_blank" rel="noopener">Google News</a>,
    <a href="{{ cdc.source_url }}" target="_blank" rel="noopener">CDC HPS surveillance</a>.
    Raw data: <a href="data.json">data.json</a>.
    Code: <a href="https://github.com/M041997/hantavirus-tracker" target="_blank" rel="noopener">GitHub</a>.
    Not a medical resource — see CDC for guidance.
  </footer>
</div>

<script>
  // Server-rendered data dump for the map.
  window.HANTA = {
    countries: {{ country_index_json|safe }},
    arcs:      {{ spread_arcs_json|safe }},
    vessel:    {{ vessel_json|safe }},
    other:     {{ other_outbreaks_json|safe }}
  };
</script>
<script>
(() => {
  const map = L.map('map', {
    zoomControl: true,
    attributionControl: true,
    worldCopyJump: true,
    minZoom: 2,
    maxZoom: 6,
    maxBounds: [[-72, -200], [82, 200]],
  }).setView([20, 0], 2);

  // Satellite imagery — clearly a globe (matches the Plague Inc. vibe).
  L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    {
      attribution: 'Tiles © Esri — Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, GIS User Community',
      maxZoom: 18,
    }
  ).addTo(map);

  // Country boundaries + labels overlay so countries are unmistakable.
  L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
    {
      attribution: '',
      maxZoom: 18,
      opacity: 0.85,
    }
  ).addTo(map);

  // Subtle dark wash so red markers pop against bright satellite imagery.
  const tint = L.rectangle(
    [[-90, -360], [90, 360]],
    { color: '#000', fillColor: '#0a1828', fillOpacity: 0.25, weight: 0,
      interactive: false }
  ).addTo(map);

  // ----- Markers -----
  const maxCount = Math.max(1, ...window.HANTA.countries.map(c => c.count));

  const escape = s => String(s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  })[c]);

  const popupHtml = (c) => {
    const items = c.items.map(i => `
      <li>
        <div class="src">${escape(i.source)} · ${escape(i.published || '')}</div>
        <a href="${escape(i.url)}" target="_blank" rel="noopener">${escape(i.title)}</a>
      </li>`).join('');
    return `
      <div class="popup-title">${escape(c.country)}</div>
      <div class="popup-meta">${c.count} reports · last ${escape(c.latest_date || '')}</div>
      <ul class="popup-list">${items}</ul>`;
  };

  window.HANTA.countries.forEach(c => {
    const big = c.count >= Math.max(3, maxCount * 0.5);
    const icon = L.divIcon({
      className: '',
      html: `<div class="pulse-marker ${big ? 'large' : ''}">
               <div class="ring"></div><div class="core"></div>
             </div>`,
      iconSize: [14, 14],
      iconAnchor: [7, 7],
    });
    L.marker([c.lat, c.lng], { icon, title: `${c.country} · ${c.count} reports` })
      .bindPopup(popupHtml(c), { maxWidth: 320 })
      .addTo(map);
  });

  // ----- Spread arcs (great-circle approximation) -----
  const greatCircle = (a, b, segs = 64) => {
    // Convert to radians
    const toRad = d => d * Math.PI / 180;
    const toDeg = r => r * 180 / Math.PI;
    const [lat1, lon1] = a.map(toRad);
    const [lat2, lon2] = b.map(toRad);
    const d = 2 * Math.asin(Math.sqrt(
      Math.sin((lat2 - lat1)/2) ** 2 +
      Math.cos(lat1) * Math.cos(lat2) * Math.sin((lon2 - lon1)/2) ** 2
    ));
    if (d === 0) return [a, b];
    const pts = [];
    for (let i = 0; i <= segs; i++) {
      const f = i / segs;
      const A = Math.sin((1 - f) * d) / Math.sin(d);
      const B = Math.sin(f * d) / Math.sin(d);
      const x = A * Math.cos(lat1) * Math.cos(lon1) + B * Math.cos(lat2) * Math.cos(lon2);
      const y = A * Math.cos(lat1) * Math.sin(lon1) + B * Math.cos(lat2) * Math.sin(lon2);
      const z = A * Math.sin(lat1) + B * Math.sin(lat2);
      const lat = Math.atan2(z, Math.sqrt(x*x + y*y));
      const lon = Math.atan2(y, x);
      pts.push([toDeg(lat), toDeg(lon)]);
    }
    return pts;
  };

  window.HANTA.arcs.forEach(arc => {
    const path = greatCircle(arc.from_latlng, arc.to_latlng);
    L.polyline(path, { className: 'spread-arc' })
      .bindTooltip(`${arc.from} → ${arc.to}<br><span style="color:#8a99ab">${arc.label}</span>`, {
        direction: 'top', sticky: true, opacity: 0.95,
      })
      .addTo(map);
  });

  // ----- MV Hondius live position -----
  if (window.HANTA.vessel && window.HANTA.vessel.position) {
    const v = window.HANTA.vessel;
    const p = v.position;
    if (Array.isArray(v.track) && v.track.length >= 2) {
      const trackPoints = v.track.map(t => [t.lat, t.lng]);
      L.polyline(trackPoints, {
        color: '#ffb84d',
        weight: 2,
        opacity: 0.7,
        dashArray: '4 5',
        className: 'ship-track',
      }).addTo(map);
    }
    const shipIcon = L.divIcon({
      className: '',
      html: `<div class="ship-marker"
                  ${p.heading_deg != null
                    ? `style="transform: rotate(${p.heading_deg}deg)"` : ''}>
               <div class="ring"></div><div class="body">⚓</div>
             </div>`,
      iconSize: [28, 28],
      iconAnchor: [14, 14],
    });
    const fetched = p.fetched_at
      ? new Date(p.fetched_at).toUTCString().replace('GMT', 'UTC')
      : '';
    const heading = p.heading_deg != null
      ? `${Math.round(p.heading_deg)}°` : '—';
    L.marker([p.lat, p.lng], {
      icon: shipIcon,
      title: `${v.name} · last AIS ${fetched}`,
      zIndexOffset: 1000,
    })
      .bindPopup(`
        <div class="popup-title">${escape(v.name)}</div>
        <div class="popup-meta">
          ${escape(v.operator)} · IMO ${escape(v.imo)} · MMSI ${escape(v.mmsi)}
        </div>
        <div style="font-size: 12px; line-height: 1.6;">
          <div><strong>Position:</strong> ${p.lat.toFixed(3)}°,
            ${p.lng.toFixed(3)}°</div>
          <div><strong>Heading:</strong> ${heading}</div>
          <div><strong>Last AIS fix:</strong> ${escape(fetched)}</div>
          <div><strong>Departed:</strong>
            ${escape(v.departed_from)} · ${escape(v.departed_at)}</div>
          <div style="margin-top: 8px;">
            <a href="${escape(v.tracker_url)}" target="_blank" rel="noopener">
              CruiseMapper</a> ·
            <a href="${escape(v.vesselfinder_url)}" target="_blank" rel="noopener">
              VesselFinder</a> ·
            <a href="${escape(v.marinetraffic_url)}" target="_blank" rel="noopener">
              MarineTraffic</a>
          </div>
        </div>
      `, { maxWidth: 320 })
      .addTo(map);
  }

  // ----- Other-outbreak map markers (colored pulses per disease) -----
  // Grouped into a single LayerGroup we add/remove with the sidebar so the
  // map stays focused on hantavirus by default.
  const otherLayer = L.layerGroup();
  (window.HANTA.other || []).forEach(ob => {
    const color = ob.color || '#c084fc';
    (ob.locations || []).forEach(loc => {
      const icon = L.divIcon({
        className: '',
        html: `<div class="pulse-marker large" style="--pc: ${color}">
                 <div class="ring"></div><div class="core"></div>
               </div>`,
        iconSize: [14, 14],
        iconAnchor: [7, 7],
      });
      const newsHtml = (ob.news || []).slice(0, 3).map(i => `
        <li>
          <div class="src" style="color:${color}">${escape(i.source)}${i.published ? ' · ' + escape(i.published) : ''}</div>
          <a href="${escape(i.url)}" target="_blank" rel="noopener">${escape(i.title)}</a>
        </li>`).join('');
      L.marker([loc.lat, loc.lng], {
        icon,
        title: `${ob.name} · ${loc.name}`,
      })
        .bindPopup(`
          <div class="popup-title" style="color:${color}">${escape(ob.name)} — ${escape(loc.name)}</div>
          <div class="popup-meta">${escape(ob.region)} · since ${escape(ob.started)}</div>
          <div style="font-size:12px; color: var(--muted); margin-bottom: 6px;">
            ${escape(ob.blurb)}
          </div>
          ${newsHtml ? `<ul class="popup-list">${newsHtml}</ul>` : ''}
        `, { maxWidth: 320 })
        .addTo(otherLayer);
    });
  });
  const applyOtherLayer = () => {
    if (document.body.classList.contains('sidebar-off')) {
      map.removeLayer(otherLayer);
    } else {
      otherLayer.addTo(map);
    }
  };
  applyOtherLayer();

  // ----- Other-outbreaks sidebar toggle (localStorage-persisted) -----
  document.getElementById('sbClose')?.addEventListener('click', () => {
    document.body.classList.add('sidebar-off');
    try { localStorage.setItem('hanta:sidebar', 'off'); } catch (e) {}
    applyOtherLayer();
  });
  document.getElementById('sbToggle')?.addEventListener('click', () => {
    document.body.classList.remove('sidebar-off');
    try { localStorage.setItem('hanta:sidebar', 'on'); } catch (e) {}
    applyOtherLayer();
  });

  // Fit to data bounds if any markers, else default world view.
  const allPoints = [
    ...window.HANTA.countries.map(c => [c.lat, c.lng]),
  ];
  if (window.HANTA.vessel && window.HANTA.vessel.position) {
    allPoints.push([
      window.HANTA.vessel.position.lat,
      window.HANTA.vessel.position.lng,
    ]);
  }
  if (allPoints.length) {
    const bounds = L.latLngBounds(allPoints);
    map.fitBounds(bounds.pad(0.4), { maxZoom: 3 });
  }
})();
</script>
</body>
</html>
