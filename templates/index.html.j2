<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hantavirus Tracker — global outbreak map</title>
<meta name="description" content="Aggregated, hourly-updated tracker of hantavirus outbreaks and news from ProMED-mail, Google News, and CDC surveillance.">
<meta property="og:title" content="Hantavirus Tracker">
<meta property="og:description" content="Hourly-updated global hantavirus outbreak and news aggregator.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><text y=%2250%22 font-size=%2256%22>&#129440;</text></svg>">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>
<style>
  :root {
    --bg: #0a0e14;
    --panel: #131a23;
    --panel-2: #1d2632;
    --ink: #e8eef5;
    --muted: #8a99ab;
    --accent: #ff3b3b;
    --accent-2: #ffb84d;
    --good: #58c897;
    --line: #28323e;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: #7cc1ff; text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* ---------- HERO MAP ---------- */
  .hero {
    position: relative;
    height: 70vh;
    min-height: 520px;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  #map {
    height: 100%; width: 100%;
    background: #0a1828;
  }
  .leaflet-container { background: #0a1828; outline: none; }
  .leaflet-control-attribution {
    background: rgba(10,14,20,.7) !important;
    color: #6b7785 !important;
    font-size: 10px !important;
  }
  .leaflet-control-attribution a { color: #8a99ab !important; }
  .leaflet-control-zoom a {
    background: rgba(20,28,38,.85) !important;
    color: #e8eef5 !important;
    border: 1px solid var(--line) !important;
  }

  /* HUD overlays */
  .hud {
    position: absolute; pointer-events: none; z-index: 500;
  }
  .hud-tl { top: 14px; left: 14px; }
  .hud-tr { top: 14px; right: 14px; }
  .hud-bl { bottom: 14px; left: 14px; }
  .hud-br { bottom: 14px; right: 14px; }
  .hud-bc {
    bottom: 14px; left: 50%; transform: translateX(-50%);
    color: var(--muted); font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(10,14,20,.6); padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--line);
  }

  .title-card {
    background: linear-gradient(135deg, rgba(20,28,38,.92), rgba(15,20,28,.85));
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 16px;
    pointer-events: auto;
  }
  .title-card h1 {
    margin: 0; font-size: 18px; letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .title-card h1 .dot {
    display: inline-block; width: 9px; height: 9px; border-radius: 50%;
    background: var(--accent); margin-right: 8px;
    box-shadow: 0 0 0 4px rgba(255,59,59,.18);
    animation: pulse 2.4s ease-in-out infinite;
    vertical-align: middle;
  }
  .title-card .sub {
    color: var(--muted); font-size: 12px; margin-top: 2px;
    font-variant-numeric: tabular-nums;
  }

  .stat-strip {
    display: flex; gap: 8px; pointer-events: auto;
  }
  .stat-tile {
    background: rgba(20,28,38,.92);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 14px;
    min-width: 110px;
  }
  .stat-tile .v {
    font-size: 22px; font-weight: 700; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat-tile .v.alert { color: var(--accent); }
  .stat-tile .v.warn  { color: var(--accent-2); }
  .stat-tile .k {
    color: var(--muted); font-size: 10px; text-transform: uppercase;
    letter-spacing: 0.08em; margin-top: 4px;
  }

  .legend {
    background: rgba(20,28,38,.92);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    color: var(--muted); font-size: 11px;
    pointer-events: auto;
  }
  .legend .row { display: flex; align-items: center; gap: 8px; }
  .legend .row + .row { margin-top: 4px; }
  .legend .swatch {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(255,59,59,.25);
  }
  .legend .swatch.arc {
    width: 18px; height: 2px; border-radius: 0;
    background: var(--accent-2); box-shadow: none;
  }

  /* Pulse marker (HTML divIcon) */
  .pulse-marker {
    position: relative;
    width: 14px; height: 14px;
  }
  .pulse-marker .core {
    position: absolute; inset: 0; margin: auto;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px rgba(255,59,59,.9);
  }
  .pulse-marker .ring {
    position: absolute; inset: -8px; border-radius: 50%;
    border: 2px solid var(--accent);
    opacity: 0;
    animation: ring 2.2s ease-out infinite;
  }
  .pulse-marker.large .core {
    width: 14px; height: 14px;
    box-shadow: 0 0 14px rgba(255,59,59,1);
  }
  .pulse-marker.large .ring { inset: -12px; border-width: 3px; }
  @keyframes ring {
    0%   { transform: scale(0.4); opacity: 0.9; }
    100% { transform: scale(1.6); opacity: 0; }
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(255,59,59,.18); }
    50%      { box-shadow: 0 0 0 10px rgba(255,59,59,0); }
  }

  /* Animated dashed spread arcs */
  @keyframes dash {
    to { stroke-dashoffset: -40; }
  }
  .leaflet-overlay-pane path.spread-arc {
    stroke: var(--accent-2);
    stroke-width: 2;
    stroke-dasharray: 6 6;
    fill: none;
    opacity: 0.85;
    animation: dash 1.6s linear infinite;
  }

  /* Popup styling */
  .leaflet-popup-content-wrapper {
    background: #131a23 !important;
    color: var(--ink) !important;
    border: 1px solid var(--line) !important;
    border-radius: 10px !important;
  }
  .leaflet-popup-tip { background: #131a23 !important; border: 1px solid var(--line) !important; }
  .leaflet-popup-content { margin: 12px 14px !important; min-width: 240px; }
  .popup-title {
    font-weight: 700; font-size: 15px; margin-bottom: 6px;
    color: var(--accent-2); text-transform: uppercase; letter-spacing: 0.04em;
  }
  .popup-meta { color: var(--muted); font-size: 11px; margin-bottom: 8px; }
  .popup-list { padding: 0; margin: 0; list-style: none; }
  .popup-list li { padding: 6px 0; border-top: 1px solid var(--line); font-size: 12px; }
  .popup-list li:first-child { border-top: 0; }
  .popup-list .src { color: var(--good); font-size: 10px; text-transform: uppercase; }

  /* ---------- BELOW-MAP CONTENT ---------- */
  .wrap { max-width: 1100px; margin: 0 auto; padding: 28px 20px 80px; }
  .grid { display: grid; gap: 18px; grid-template-columns: repeat(12, 1fr); }
  .card {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 12px; padding: 18px 20px;
  }
  .card h2 {
    margin: 0 0 12px; font-size: 14px; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--muted);
  }
  .span-12 { grid-column: span 12; }
  .span-8  { grid-column: span 8; }
  .span-4  { grid-column: span 4; }
  @media (max-width: 800px) {
    .span-8, .span-4 { grid-column: span 12; }
    .stat-strip { flex-wrap: wrap; }
    .stat-tile { min-width: 95px; padding: 8px 10px; }
    .stat-tile .v { font-size: 18px; }
    .hero { height: 60vh; min-height: 420px; }
    .hud-bl { display: none; }
  }

  ul.items { list-style: none; padding: 0; margin: 0; }
  ul.items li { padding: 10px 0; border-bottom: 1px solid var(--line); }
  ul.items li:last-child { border-bottom: 0; }
  ul.items .title { font-weight: 600; line-height: 1.35; }
  ul.items .row {
    display: flex; gap: 8px; align-items: center; margin-top: 4px;
    color: var(--muted); font-size: 12px; flex-wrap: wrap;
  }
  ul.items .src { color: var(--good); }
  ul.items .src.promed { color: var(--accent-2); }

  .stats-mini { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .stats-mini .stat { background: var(--panel-2); border-radius: 10px; padding: 12px 14px; }
  .stats-mini .v { font-size: 22px; font-weight: 700; }
  .stats-mini .k { color: var(--muted); font-size: 12px; text-transform: uppercase;
                   letter-spacing: 0.06em; margin-top: 2px; }

  footer {
    margin-top: 40px; color: var(--muted); font-size: 12px;
    border-top: 1px solid var(--line); padding-top: 16px;
  }
  footer a { color: var(--muted); text-decoration: underline; }
</style>
</head>
<body>

<div class="hero">
  <div id="map"></div>

  <div class="hud hud-tl">
    <div class="title-card">
      <h1><span class="dot"></span>Hantavirus Tracker</h1>
      <div class="sub">Updated {{ build_time_human }} · rebuilds hourly</div>
    </div>
  </div>

  <div class="hud hud-tr">
    <div class="stat-strip">
      <div class="stat-tile"><div class="v alert">{{ active_country_count }}</div>
        <div class="k">Active countries</div></div>
      <div class="stat-tile"><div class="v warn">{{ reports_today }}</div>
        <div class="k">Reports today</div></div>
      <div class="stat-tile"><div class="v">{{ promed_count + news_count }}</div>
        <div class="k">Items tracked</div></div>
      <div class="stat-tile"><div class="v alert">{{ cdc.case_fatality_rate_pct }}%</div>
        <div class="k">US CFR · CDC</div></div>
    </div>
  </div>

  <div class="hud hud-bl">
    <div class="legend">
      <div class="row"><span class="swatch"></span>Reported activity (last 60d)</div>
      <div class="row"><span class="swatch arc"></span>Documented spread route</div>
    </div>
  </div>

  <div class="hud hud-bc">
    Click a marker · drag to pan · scroll to zoom
  </div>
</div>

<div class="wrap">
  <div class="grid">
    <div class="card span-8">
      <h2>ProMED-mail · official outbreak alerts</h2>
      {% if promed_items %}
      <ul class="items">
        {% for item in promed_items %}
        <li>
          <div class="title">
            <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title|unescape }}</a>
          </div>
          <div class="row">
            <span class="src promed">{{ item.source }}</span>
            {% if item.published_human %}<span>·</span><span>{{ item.published_human }}</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div style="color: var(--muted);">No ProMED items fetched in this build.</div>
      {% endif %}
    </div>

    <div class="card span-4">
      <h2>CDC US snapshot</h2>
      <div class="stats-mini">
        <div class="stat"><div class="v">{{ cdc.total_cases }}</div>
          <div class="k">Total cases</div></div>
        <div class="stat"><div class="v">{{ cdc.case_fatality_rate_pct }}%</div>
          <div class="k">Fatality rate</div></div>
        <div class="stat"><div class="v">{{ cdc.hps_cases }}</div>
          <div class="k">HPS cases</div></div>
        <div class="stat"><div class="v">{{ cdc.pct_west_of_mississippi }}%</div>
          <div class="k">West of Miss.</div></div>
      </div>
      <p style="color: var(--muted); margin-top:12px; font-size: 12px;">
        Surveillance period {{ cdc.surveillance_start }} – {{ cdc.as_of[:4] }}.
        Median age {{ cdc.median_age }}, {{ cdc.pct_male }}% male.
        <a href="{{ cdc.source_url }}" target="_blank" rel="noopener">Source: CDC</a>.
      </p>
    </div>

    <div class="card span-12">
      <h2>News &amp; press · last {{ news_items|length }} items</h2>
      {% if news_items %}
      <ul class="items">
        {% for item in news_items %}
        <li>
          <div class="title">
            <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title|unescape }}</a>
          </div>
          <div class="row">
            <span class="src">{{ item.source }}</span>
            {% if item.published_human %}<span>·</span><span>{{ item.published_human }}</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>

  <footer>
    Sources: <a href="https://promedmail.org/?s=hantavirus" target="_blank" rel="noopener">ProMED-mail</a>,
    <a href="https://news.google.com/search?q=hantavirus" target="_blank" rel="noopener">Google News</a>,
    <a href="{{ cdc.source_url }}" target="_blank" rel="noopener">CDC HPS surveillance</a>.
    Raw aggregated data: <a href="data.json">data.json</a>.
    Source: <a href="https://github.com/M041997/hantavirus-tracker" target="_blank" rel="noopener">GitHub</a>.
    Not a medical resource — see CDC for guidance.
  </footer>
</div>

<script>
  // Server-rendered data dump for the map.
  window.HANTA = {
    countries: {{ country_index_json|safe }},
    arcs:      {{ spread_arcs_json|safe }}
  };
</script>
<script>
(() => {
  const map = L.map('map', {
    zoomControl: true,
    attributionControl: true,
    worldCopyJump: true,
    minZoom: 2,
    maxZoom: 6,
    maxBounds: [[-72, -200], [82, 200]],
  }).setView([20, 0], 2);

  // Satellite imagery — clearly a globe (matches the Plague Inc. vibe).
  L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    {
      attribution: 'Tiles © Esri — Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, GIS User Community',
      maxZoom: 18,
    }
  ).addTo(map);

  // Country boundaries + labels overlay so countries are unmistakable.
  L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
    {
      attribution: '',
      maxZoom: 18,
      opacity: 0.85,
    }
  ).addTo(map);

  // Subtle dark wash so red markers pop against bright satellite imagery.
  const tint = L.rectangle(
    [[-90, -360], [90, 360]],
    { color: '#000', fillColor: '#0a1828', fillOpacity: 0.25, weight: 0,
      interactive: false }
  ).addTo(map);

  // ----- Markers -----
  const maxCount = Math.max(1, ...window.HANTA.countries.map(c => c.count));

  const escape = s => String(s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  })[c]);

  const popupHtml = (c) => {
    const items = c.items.map(i => `
      <li>
        <div class="src">${escape(i.source)} · ${escape(i.published || '')}</div>
        <a href="${escape(i.url)}" target="_blank" rel="noopener">${escape(i.title)}</a>
      </li>`).join('');
    return `
      <div class="popup-title">${escape(c.country)}</div>
      <div class="popup-meta">${c.count} reports · last ${escape(c.latest_date || '')}</div>
      <ul class="popup-list">${items}</ul>`;
  };

  window.HANTA.countries.forEach(c => {
    const big = c.count >= Math.max(3, maxCount * 0.5);
    const icon = L.divIcon({
      className: '',
      html: `<div class="pulse-marker ${big ? 'large' : ''}">
               <div class="ring"></div><div class="core"></div>
             </div>`,
      iconSize: [14, 14],
      iconAnchor: [7, 7],
    });
    L.marker([c.lat, c.lng], { icon, title: `${c.country} · ${c.count} reports` })
      .bindPopup(popupHtml(c), { maxWidth: 320 })
      .addTo(map);
  });

  // ----- Spread arcs (great-circle approximation) -----
  const greatCircle = (a, b, segs = 64) => {
    // Convert to radians
    const toRad = d => d * Math.PI / 180;
    const toDeg = r => r * 180 / Math.PI;
    const [lat1, lon1] = a.map(toRad);
    const [lat2, lon2] = b.map(toRad);
    const d = 2 * Math.asin(Math.sqrt(
      Math.sin((lat2 - lat1)/2) ** 2 +
      Math.cos(lat1) * Math.cos(lat2) * Math.sin((lon2 - lon1)/2) ** 2
    ));
    if (d === 0) return [a, b];
    const pts = [];
    for (let i = 0; i <= segs; i++) {
      const f = i / segs;
      const A = Math.sin((1 - f) * d) / Math.sin(d);
      const B = Math.sin(f * d) / Math.sin(d);
      const x = A * Math.cos(lat1) * Math.cos(lon1) + B * Math.cos(lat2) * Math.cos(lon2);
      const y = A * Math.cos(lat1) * Math.sin(lon1) + B * Math.cos(lat2) * Math.sin(lon2);
      const z = A * Math.sin(lat1) + B * Math.sin(lat2);
      const lat = Math.atan2(z, Math.sqrt(x*x + y*y));
      const lon = Math.atan2(y, x);
      pts.push([toDeg(lat), toDeg(lon)]);
    }
    return pts;
  };

  window.HANTA.arcs.forEach(arc => {
    const path = greatCircle(arc.from_latlng, arc.to_latlng);
    L.polyline(path, { className: 'spread-arc' })
      .bindTooltip(`${arc.from} → ${arc.to}<br><span style="color:#8a99ab">${arc.label}</span>`, {
        direction: 'top', sticky: true, opacity: 0.95,
      })
      .addTo(map);
  });

  // Fit to data bounds if any markers, else default world view.
  if (window.HANTA.countries.length) {
    const bounds = L.latLngBounds(window.HANTA.countries.map(c => [c.lat, c.lng]));
    map.fitBounds(bounds.pad(0.4), { maxZoom: 3 });
  }
})();
</script>
</body>
</html>
