<script>
  // Apply sidebar visibility before rendering to avoid a flash.
  try {
    if (localStorage.getItem('hanta:sidebar') === 'off') {
      document.body.classList.add('sidebar-off');
    }
  } catch (e) {}
</script>

{% if other_outbreaks %}
<aside class="sidebar" id="otherOutbreaks">
  <div class="sb-head">
    <h3>Other active outbreaks</h3>
    <button class="sb-close" id="sbClose" title="Hide sidebar" aria-label="Hide sidebar">×</button>
  </div>
  <div class="sb-nav" id="sbNav">
    <button class="sb-arrow" id="sbPrev" type="button" aria-label="Previous outbreak" title="Previous (←)">‹</button>
    <div class="sb-dots" id="sbDots" aria-hidden="true">
      {% for ob in other_outbreaks %}
      <span class="d" data-ob-key="{{ ob.key }}" title="{{ ob.name }}"></span>
      {% endfor %}
    </div>
    <button class="sb-arrow" id="sbNext" type="button" aria-label="Next outbreak" title="Next (→)">›</button>
  </div>
  <div class="sb-body">
    {% for ob in other_outbreaks %}
    <div class="ob" data-ob-key="{{ ob.key }}">
      <div class="ob-name">
        <span class="ob-dot" style="background: {{ ob.color }}"></span>{{ ob.name }}
        {% if ob.status == "live" %}
        <span class="ob-badge live" title="Counters scraped from {{ ob.source }} this build">● Live</span>
        {% endif %}
      </div>
      <div class="ob-region">{{ ob.region }} · {{ ob.started_human or ob.started }}</div>
      {% if ob.status == "live" and (ob.cases is not none or ob.deaths is not none) %}
      <div class="ob-tickers"
           title="{% if ob.source %}{{ ob.source }}{% endif %}{% if ob.as_of %} · as of {{ ob.as_of }}{% endif %}">
        {% if ob.cases is not none %}
        <span class="ob-tick">
          <span class="v" style="color: {{ ob.color }}">{{ '{:,}'.format(ob.cases) }}</span>
          <span class="k">cases</span>
        </span>
        {% endif %}
        {% if ob.deaths is not none %}
        <span class="ob-tick">
          <span class="v alert">{{ '{:,}'.format(ob.deaths) }}</span>
          <span class="k">deaths</span>
        </span>
        {% endif %}
        {% if ob.as_of %}
        <span class="ob-asof">
          {% if ob.source_url %}<a href="{{ ob.source_url }}" target="_blank" rel="noopener">{{ ob.source or 'source' }}</a>{% else %}{{ ob.source or '' }}{% endif %}
          · as of {{ ob.as_of }}
        </span>
        {% endif %}
      </div>
      {% endif %}
      <div class="ob-blurb">{{ ob.blurb }}</div>
      {% if ob.news %}
      <ul>
        {% for i in ob.news[:4] %}
        <li>
          <a href="{{ i.url }}" target="_blank" rel="noopener">{{ i.title|unescape }}</a>
          <div class="meta">{{ i.source }}{% if i.published %} · {{ i.published }}{% endif %}</div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div class="ob-empty">No recent coverage</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</aside>
<button class="sidebar-toggle" id="sbToggle" title="Show other outbreaks">
