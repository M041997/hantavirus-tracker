<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hantavirus Tracker — global outbreak feed</title>
<meta name="description" content="Aggregated, hourly-updated tracker of hantavirus outbreaks and news from ProMED-mail, Google News, and CDC surveillance.">
<meta property="og:title" content="Hantavirus Tracker">
<meta property="og:description" content="Hourly-updated global hantavirus outbreak and news aggregator.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><text y=%2250%22 font-size=%2256%22>&#129440;</text></svg>">
<style>
  :root {
    --bg: #0c1116;
    --panel: #161d26;
    --panel-2: #1d2632;
    --ink: #e8eef5;
    --muted: #8a99ab;
    --accent: #ff5757;
    --accent-2: #ffb84d;
    --good: #58c897;
    --line: #28323e;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: #7cc1ff; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 28px 20px 80px; }
  header {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 12px; margin-bottom: 24px;
  }
  header h1 {
    margin: 0; font-size: 28px; letter-spacing: -0.02em;
  }
  header h1 .dot {
    display: inline-block; width: 10px; height: 10px; border-radius: 50%;
    background: var(--accent); margin-right: 10px;
    box-shadow: 0 0 0 4px rgba(255,87,87,.18);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(255,87,87,.18); }
    50%      { box-shadow: 0 0 0 10px rgba(255,87,87,0); }
  }
  .meta { color: var(--muted); font-size: 13px; }
  .meta code { background: var(--panel); padding: 2px 6px; border-radius: 4px; }

  .grid {
    display: grid; gap: 18px;
    grid-template-columns: repeat(12, 1fr);
  }
  .card {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 12px; padding: 18px 20px;
  }
  .card h2 {
    margin: 0 0 12px; font-size: 16px; letter-spacing: 0.02em;
    text-transform: uppercase; color: var(--muted);
  }
  .span-12 { grid-column: span 12; }
  .span-8  { grid-column: span 8; }
  .span-6  { grid-column: span 6; }
  .span-4  { grid-column: span 4; }
  @media (max-width: 800px) {
    .span-8, .span-6, .span-4 { grid-column: span 12; }
  }

  /* Outbreak strip */
  .outbreaks {
    display: flex; flex-wrap: wrap; gap: 10px;
  }
  .outbreak {
    flex: 1 1 220px;
    background: linear-gradient(135deg, #2a1316, #1d1218);
    border: 1px solid #4a1e22;
    border-radius: 10px; padding: 12px 14px;
  }
  .outbreak .country {
    font-weight: 700; color: var(--accent-2); letter-spacing: 0.02em;
  }
  .outbreak .count {
    float: right; background: rgba(255,87,87,.12);
    color: var(--accent); padding: 2px 8px; border-radius: 999px;
    font-size: 12px; font-weight: 600;
  }
  .outbreak .latest {
    margin-top: 8px; font-size: 13px; color: var(--ink);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .outbreak .when { color: var(--muted); font-size: 12px; margin-top: 6px; }

  /* Stat tiles */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .stat {
    background: var(--panel-2); border-radius: 10px; padding: 12px 14px;
  }
  .stat .v { font-size: 22px; font-weight: 700; }
  .stat .k { color: var(--muted); font-size: 12px; text-transform: uppercase;
             letter-spacing: 0.06em; margin-top: 2px; }
  @media (max-width: 600px) { .stats { grid-template-columns: repeat(2, 1fr); } }

  /* Item lists */
  ul.items { list-style: none; padding: 0; margin: 0; }
  ul.items li {
    padding: 10px 0; border-bottom: 1px solid var(--line);
  }
  ul.items li:last-child { border-bottom: 0; }
  ul.items .title { font-weight: 600; line-height: 1.35; }
  ul.items .row {
    display: flex; gap: 8px; align-items: center; margin-top: 4px;
    color: var(--muted); font-size: 12px; flex-wrap: wrap;
  }
  ul.items .src { color: var(--good); }
  ul.items .src.promed { color: var(--accent-2); }

  footer {
    margin-top: 40px; color: var(--muted); font-size: 12px;
    border-top: 1px solid var(--line); padding-top: 16px;
  }
  footer a { color: var(--muted); text-decoration: underline; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1><span class="dot"></span>Hantavirus Tracker</h1>
    <div class="meta">
      Updated <code>{{ build_time_human }}</code> · rebuilds hourly
    </div>
  </header>

  {% if outbreaks %}
  <div class="card span-12" style="margin-bottom: 18px;">
    <h2>Active clusters (last 60 days)</h2>
    <div class="outbreaks">
      {% for o in outbreaks %}
      <div class="outbreak">
        <span class="count">{{ o.count }} reports</span>
        <div class="country">{{ o.country }}</div>
        <div class="latest">
          <a href="{{ o.latest_url }}" target="_blank" rel="noopener">{{ o.latest_title|unescape }}</a>
        </div>
        <div class="when">latest: {{ o.latest_date }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="grid">
    <div class="card span-8">
      <h2>ProMED-mail · official outbreak alerts</h2>
      {% if promed_items %}
      <ul class="items">
        {% for item in promed_items %}
        <li>
          <div class="title">
            <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title|unescape }}</a>
          </div>
          <div class="row">
            <span class="src promed">{{ item.source }}</span>
            {% if item.published_human %}<span>·</span><span>{{ item.published_human }}</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div class="meta">No ProMED items fetched in this build.</div>
      {% endif %}
    </div>

    <div class="card span-4">
      <h2>CDC US snapshot</h2>
      <div class="stats">
        <div class="stat"><div class="v">{{ cdc.total_cases }}</div>
          <div class="k">Total cases</div></div>
        <div class="stat"><div class="v">{{ cdc.case_fatality_rate_pct }}%</div>
          <div class="k">Fatality rate</div></div>
        <div class="stat"><div class="v">{{ cdc.hps_cases }}</div>
          <div class="k">HPS cases</div></div>
        <div class="stat"><div class="v">{{ cdc.pct_west_of_mississippi }}%</div>
          <div class="k">West of Miss.</div></div>
      </div>
      <p class="meta" style="margin-top:12px;">
        Surveillance period {{ cdc.surveillance_start }} – {{ cdc.as_of[:4] }}.
        Median age {{ cdc.median_age }}, {{ cdc.pct_male }}% male.
        <a href="{{ cdc.source_url }}" target="_blank" rel="noopener">Source: CDC</a>.
      </p>
    </div>

    <div class="card span-12">
      <h2>News &amp; press · last {{ news_items|length }} items</h2>
      {% if news_items %}
      <ul class="items">
        {% for item in news_items %}
        <li>
          <div class="title">
            <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title|unescape }}</a>
          </div>
          <div class="row">
            <span class="src">{{ item.source }}</span>
            {% if item.published_human %}<span>·</span><span>{{ item.published_human }}</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div class="meta">No news items in this build.</div>
      {% endif %}
    </div>
  </div>

  <footer>
    Sources: <a href="https://promedmail.org/?s=hantavirus" target="_blank" rel="noopener">ProMED-mail</a>,
    <a href="https://news.google.com/search?q=hantavirus" target="_blank" rel="noopener">Google News</a>,
    <a href="{{ cdc.source_url }}" target="_blank" rel="noopener">CDC HPS surveillance</a>.
    Raw aggregated data: <a href="data.json">data.json</a>.
    Not a medical resource — see CDC for guidance.
  </footer>
</div>
</body>
</html>
